#!/usr/bin/env python3
"""What is in this image: every tool with the digest a results file would cite.

    tla-kit-info [--json]

The digests are measured from the files, not read from a record, so they say what is installed. Beside them are
the build arguments the image was made with, the commit it was built from and that commit's time (the OCI
revision and created labels, ADR-0014 item 8), and the inventory of what it is meant to hold and where each part
came from (/opt/tla-kit/PINS.json, ADR-0013 item 7). The self-test (tla-kit-selftest) checks that they agree.
--json prints the same facts as one JSON object, for scripts and for the MCP server's info tool.
"""
import hashlib
import json
import os
import platform
import re
import subprocess
import sys

JAR = os.environ.get("TLA_JAR", "/opt/tla/tla2tools.jar")
TLAPM = os.environ.get("TLAPM", "/opt/tlaps/bin/tlapm")
SKILL = os.environ.get("TLA_KIT_SKILL", "/opt/tla-kit/skill")
BUILD_ARGS = "/opt/tla-kit/build-args"
PINS = "/opt/tla-kit/PINS.json"


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        return f"({e})"
    return p.stdout + p.stderr


def key_values(path):
    out = {}
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    k, _, v = line.partition(" ")
                    out.setdefault(k, v.strip())
    return out


def os_name():
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "unknown"


def facts():
    java = run(["java", "-version"]).strip().splitlines()
    tlc = re.search(r"^TLC2 Version.*$", run(["java", "-cp", JAR, "tlc2.TLC"]), re.M)
    version = run([TLAPM, "--version"]).strip().splitlines()
    backends = re.findall(r'^(\S[^=\n]*) version == "(.*)"$', run([TLAPM, "--config"]), re.M)
    pin = key_values(os.path.join(SKILL, "VENDOR-PIN"))
    args = key_values(BUILD_ARGS)
    try:
        with open(PINS, encoding="utf-8") as f:
            inventory = json.load(f)["pins"]
    except (OSError, ValueError, KeyError):
        inventory = []
    return {
        "platform": f"{platform.system()} {platform.machine()}",
        "os": os_name(),
        "user": f"uid {os.getuid()}, gid {os.getgid()}",
        "java": java[0] if java else "not found",
        "python": platform.python_version(),
        "checker": {"path": JAR, "sha256": sha256(JAR) if os.path.isfile(JAR) else None,
                    "tlc": tlc.group(0) if tlc else None},
        "prover": {"path": TLAPM, "sha256": sha256(TLAPM) if os.path.isfile(TLAPM) else None,
                   "version": version[-1] if version else None},
        "backends": [{"name": n, "version": v} for n, v in backends],
        "skill": {"path": SKILL, "source": pin.get("source"), "commit": pin.get("commit")},
        "packages": key_values("/opt/tla-kit/packages"),
        "image": {"source": "https://github.com/scottcochran/tla-kit", "revision": args.get("revision"),
                  "created": args.get("created")},
        "build_args": {k: v for k, v in args.items() if k not in ("revision", "created")},
        "pins": [{k: p.get(k) for k in ("tool", "kind", "version", "upstream", "kept_copy") if k in p}
                 for p in inventory],
    }


def main(argv):
    f = facts()
    if "--json" in argv:
        print(json.dumps(f, indent=2))
        return 0
    print(f"platform  {f['platform']}, {f['os']}")
    print(f"user      {f['user']}")
    print(f"java      {f['java']}")
    print(f"python    Python {f['python']}")
    print(f"checker   {f['checker']['path']} sha256 {f['checker']['sha256']}")
    print(f"tlc       {f['checker']['tlc']}")
    print(f"prover    {f['prover']['path']} sha256 {f['prover']['sha256']}")
    print(f"tlapm     {f['prover']['version']}")
    for b in f["backends"]:
        print(f"backend   {b['name']} version == \"{b['version']}\"")
    print(f"skill     {f['skill']['path']}, from {f['skill']['source']} at {f['skill']['commit']}")
    for k, v in f["packages"].items():
        print(f"package   {k} {v}")
    print(f"image     {f['image']['source']} at {f['image']['revision']}, committed {f['image']['created']}")
    for k, v in f["build_args"].items():
        print(f"build     {k} {v}")
    for p in f["pins"]:
        where = p.get("kept_copy") or p.get("upstream")
        print(f"pin       {p['kind']:8} {p['tool']} {p.get('version', '')}".rstrip() + (f", from {where}" if where else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
