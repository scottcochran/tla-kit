#!/usr/bin/env python3
"""Check that this image does what it says, in a few minutes, writing nothing outside a temp directory.

    tla-kit-selftest

One line per check, `ok` or `FAIL`, with the seconds it took:

  pins     the jar and the tlapm binary have the sha256 of the build arguments (/opt/tla-kit/build-args); the
           build arguments are the values the inventory gives them, and every file the inventory lists has its
           sha256 (/opt/tla-kit/PINS.json, ADR-0013 item 7); every vendored file of the skill has the sha256 its
           VENDOR-PIN names
  env      TLA_JAR and TLAPM name those files, and the tlapm on PATH is the same binary (ADR-0004)
  notices  every licence text the image's notice of third-party software names exists, and every jar it names
           holds a License.txt (/opt/tla-kit/licenses/THIRD-PARTY.md, ADR-0011 item 4)
  sany     the sany wrapper parses the skill's fixture module, and reports an error in a module that has one
  pcal     the pcal wrapper translates a small PlusCal algorithm, and sany parses the result
  tlc      the tlc wrapper checks the fixture at Limit = 3: no error, 4 distinct states
  setup    the skill's setup_check.py --proofs, in an empty project whose tools/TLAPS-PIN holds the build
           arguments' tlapm digest: all fixture rows as expected, the fixture's proof proved, and its flip test
           failing as required
  mcp      the MCP server (tla-kit mcp) starts over stdio on a copy of the fixture, lists its tools, and its
           tlc_run finds the fixture's Bounded to hold in 4 states (ADR-0008)

Exits non-zero if any check fails.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile

# SANY exits 0 on a semantic error, so its output is read, not its exit status.
SANY_ERROR = re.compile(r"\*\*\* ?(Errors?|Parse Error|Abort)|^Fatal errors|^Semantic errors:", re.M)
JAR = os.environ.get("TLA_JAR", "")
TLAPM = os.environ.get("TLAPM", "")
SKILL = os.environ.get("TLA_KIT_SKILL", "/opt/tla-kit/skill")
FIXTURE = os.path.join(SKILL, "assets", "selftest")
PINS = "/opt/tla-kit/PINS.json"
# The build-args keys and the inventory's build arguments they record.
RECORDED = {"base_image": "BASE_IMAGE", "apt_snapshot": "APT_SNAPSHOT", "tla2tools_version": "TLA2TOOLS_VERSION",
            "tla2tools_sha256": "TLA2TOOLS_SHA256", "tlapm_tag": "TLAPM_TAG", "tlapm_tarball_sha256": "TLAPM_SHA256",
            "tlapm_binary_sha256": "TLAPM_BINARY_SHA256"}
failed = []

PCAL = """---- MODULE Pcal ----
EXTENDS Naturals
(* --algorithm Pcal
variables x = 0;
begin
  Inc: while x < 2 do x := x + 1; end while;
end algorithm; *)
====
"""


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def key_values(path):
    out, files = {}, {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                k, _, v = line.partition(" ")
                if k == "file":
                    d, _, name = v.partition(" ")
                    files[name] = d
                else:
                    out[k] = v.strip()
    return out, files


def run(cmd, cwd):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


def report(name, start, ok, detail, out=""):
    print(f"{name:8} {'ok' if ok else 'FAIL':4} {time.time() - start:6.1f}s  {detail}", flush=True)
    if not ok:
        failed.append(name)
        if out:
            print("\n".join("         " + line for line in out.rstrip().splitlines()[-15:]), flush=True)


def check_pins():
    start = time.time()
    args, _ = key_values("/opt/tla-kit/build-args")
    problems = []
    for label, path, want in (("jar", JAR, args.get("tla2tools_sha256")), ("tlapm", TLAPM, args.get("tlapm_binary_sha256"))):
        got = sha256(path) if os.path.isfile(path) else None
        if got != want:
            problems.append(f"{label} {path} is sha256 {got}, the build arguments say {want}")
    listed = 0
    try:
        with open(PINS, encoding="utf-8") as f:
            inventory = json.load(f)
    except (OSError, ValueError) as e:
        inventory = {"pins": []}
        problems.append(f"no inventory: {e}")
    set_by = {}
    for p in inventory["pins"]:
        set_by.update(p.get("set_by", {}))
        if isinstance(p.get("installed"), dict):
            for path, want in p["installed"].items():
                listed += 1
                got = sha256(path) if os.path.isfile(path) else None
                if got != want:
                    problems.append(f"{path} is sha256 {got}, PINS.json says {want}")
    for key, arg in RECORDED.items():
        if arg in set_by and args.get(key) != set_by[arg]:
            problems.append(f"built with {arg}={args.get(key)}, PINS.json says {set_by[arg]}")
    pin, files = key_values(os.path.join(SKILL, "VENDOR-PIN"))
    for name, want in files.items():
        path = os.path.join(SKILL, name)
        if not os.path.isfile(path) or sha256(path) != want:
            problems.append(f"skill file {name} differs from VENDOR-PIN")
    report("pins", start, not problems and listed > 0, "; ".join(problems[:5]) or
           f"jar and tlapm as built; built with the inventory's values, and its {listed} installed files as it "
           f"lists them; {len(files)} skill files as vendored from {pin.get('commit', '?')[:12]}")
    return args


def check_env():
    start = time.time()
    on_path = shutil.which("tlapm")
    problems = [f"{v} is not set to a file" for v, p in (("TLA_JAR", JAR), ("TLAPM", TLAPM)) if not os.path.isfile(p)]
    if not on_path or os.path.realpath(on_path) != os.path.realpath(TLAPM):
        problems.append(f"tlapm on PATH is {on_path}, not TLAPM")
    report("env", start, not problems, "; ".join(problems) or f"TLA_JAR={JAR}, TLAPM={TLAPM}, tlapm on PATH")


def check_notices():
    start = time.time()
    notice = "/opt/tla-kit/licenses/THIRD-PARTY.md"
    problems, paths = [], []
    if not os.path.isfile(notice):
        problems.append(f"no {notice}")
    else:
        with open(notice, encoding="utf-8") as f:
            for line in f:
                cells = line.split("|")
                if len(cells) >= 7 and not set(cells[4].strip()) <= set("-") and cells[4].strip() != "Licence text in the image":
                    paths += re.findall(r"`(/[^`]+)`", cells[4])
        paths += ["/opt/tla-kit/LICENSE", "/opt/tla-kit/LICENSE-DOCS", "/opt/tla-kit/NOTICE"]
        for p in paths:
            if not os.path.exists(p):
                problems.append(f"{p} is missing")
            elif p.endswith(".jar"):
                try:
                    if "License.txt" not in zipfile.ZipFile(p).namelist():
                        problems.append(f"{p} holds no License.txt")
                except (OSError, zipfile.BadZipFile) as e:
                    problems.append(f"{p}: {e}")
    report("notices", start, not problems and len(paths) > 3, "; ".join(problems) or
           f"{len(paths)} licence texts named by the notice and tla-kit's own, all present")


def check_wrappers(tmp):
    for f in ("Counter.tla", "Counter_proof.tla"):
        shutil.copy(os.path.join(FIXTURE, f), tmp)

    start = time.time()
    code, out = run(["sany", "Counter.tla"], tmp)
    ok = code == 0 and "Semantic processing of module Counter" in out and not SANY_ERROR.search(out)
    if ok:  # and the check can fail: a module with an unknown operator is reported
        with open(os.path.join(tmp, "Bad.tla"), "w", encoding="utf-8") as f:
            f.write("---- MODULE Bad ----\nEXTENDS Naturals\nX == Y + 1\n====\n")
        code, out = run(["sany", "Bad.tla"], tmp)
        ok = bool(SANY_ERROR.search(out)) and "Unknown operator" in out
        out = out if not ok else ""
    report("sany", start, ok, "Counter.tla parsed, and an unknown operator in another module reported" if ok
           else f"exit {code}", out)

    start = time.time()
    with open(os.path.join(tmp, "Pcal.tla"), "w", encoding="utf-8") as f:
        f.write(PCAL)
    code, out = run(["pcal", "-nocfg", "Pcal.tla"], tmp)
    ok = code == 0 and "Translation completed" in out
    if ok:
        code, out = run(["sany", "Pcal.tla"], tmp)
        ok = code == 0 and "Semantic processing of module Pcal" in out and not SANY_ERROR.search(out)
    report("pcal", start, ok, "an algorithm translated, and its translation parsed" if ok else f"exit {code}", out)

    start = time.time()
    with open(os.path.join(tmp, "MC.cfg"), "w", encoding="utf-8") as f:
        f.write('SPECIFICATION Spec\nCONSTANTS\n  Mut = "none"\n  Limit = 3\nINVARIANT Bounded\n')
    code, out = run(["tlc", "-config", "MC.cfg", "-workers", "1", "-deadlock",
                     "-metadir", os.path.join(tmp, "meta"), "Counter.tla"], tmp)
    states = re.findall(r"([0-9,]+) distinct states found", out)
    ok = code == 0 and "No error has been found" in out and states and states[-1] == "4"
    report("tlc", start, ok, "Counter at Limit = 3: no error, 4 distinct states" if ok else f"exit {code}", out)


def check_setup(tmp, args):
    start = time.time()
    project = os.path.join(tmp, "project")
    os.makedirs(os.path.join(project, "tools"))
    with open(os.path.join(project, "tools", "TLAPS-PIN"), "w", encoding="utf-8") as f:
        f.write("# Written by tla-kit-selftest from /opt/tla-kit/build-args.\n"
                f"version {args.get('tlapm_tag', 'unknown')}\nbinary_sha256 {args.get('tlapm_binary_sha256')}\n")
    code, out = run([sys.executable, os.path.join(SKILL, "scripts", "setup_check.py"), "--proofs", "--dir", project],
                    project)
    ok = code == 0 and "setup: ready for model checking and proofs" in out
    report("setup", start, ok, "the skill's setup check: ready for model checking and proofs" if ok else f"exit {code}")
    print("\n".join("         " + line for line in out.rstrip().splitlines()), flush=True)


def check_mcp(tmp):
    start = time.time()
    project = os.path.join(tmp, "mcp-project")
    os.makedirs(os.path.join(project, "spec"))
    for f in ("Counter.tla", "Counter-rows.txt"):
        shutil.copy(os.path.join(FIXTURE, f), os.path.join(project, "spec"))
    p = subprocess.Popen(["tla-kit", "mcp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, env=dict(os.environ, TLA_KIT_PROJECT=project))
    msgs = [{"jsonrpc": "2.0", "id": 1, "method": "initialize",
             "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "selftest"}}},
            {"jsonrpc": "2.0", "method": "notifications/initialized"},
            {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
            {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "tlc_run", "arguments": {
                "module": "spec/Counter.tla", "mut": "none", "property": "Bounded", "states": 4}}}]
    try:
        out, err = p.communicate("".join(json.dumps(m) + "\n" for m in msgs), timeout=300)
        replies = {r.get("id"): r for r in map(json.loads, out.splitlines())}
        tools = [x["name"] for x in replies[2]["result"]["tools"]]
        row = replies[3]["result"]["structuredContent"]
        ok = {"tlc_run", "tlc_rows", "prove"} <= set(tools) and row["verdict"] == "HOLDS" \
            and row["count"] == "4 distinct states"
        detail = f"{len(tools)} tools; tlc_run: Bounded {row['verdict']}, {row['count']}"
    except Exception as e:  # any failure to start, answer or parse is this check's failure
        ok, detail, err = False, f"{e!r}", locals().get("err", "")
    report("mcp", start, ok, detail, "" if ok else err)


def main():
    args = check_pins()
    check_env()
    check_notices()
    tmp = tempfile.mkdtemp(prefix="tla-kit-selftest_")
    try:
        check_wrappers(tmp)
        check_setup(tmp, args)
        check_mcp(tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print("selftest: " + ("ok" if not failed else f"FAILED ({', '.join(failed)})"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
